#!/bin/sh
#
# Pre-commit hook: reject a commit that would introduce a file without a final
# newline.
#
# Installed by `pnpm hooks:install`, which points `core.hooksPath` at this
# directory (see `.gitconfig`-free setup below). Kept as a plain shell script
# with no Node dependency at commit time beyond `node` itself, which the project
# already requires.
#
# Same rules as `scripts/check-final-newline.mjs`: tracked text files only,
# binary files skipped. Bypass for one commit with `git commit --no-verify`.

node scripts/check-final-newline.mjs || {
  echo ""
  echo "Pre-commit check failed. Fix, or bypass once with: git commit --no-verify"
  exit 1
}
