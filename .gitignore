dist/
.astro/

# dependencies
node_modules/
# pnpm puts its content-addressable store here when it cannot reach the
# default location; it must never be committed.
.pnpm-store/

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# environment
.env
.env.*
!.env.example

# editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Local screenshot output. Kept ignored so an ad-hoc capture can never be
# committed, but no longer used in the review flow: layout is verified with
# programmatic measurements (geometry, computed styles, contrast) instead.
review/

