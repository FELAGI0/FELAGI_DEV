---
import Footer from '@/components/Footer.astro';
import LangSwitcher from '@/components/LangSwitcher.astro';
import Logo from '@/components/Logo.astro';
import ThemeScript from '@/components/ThemeScript.astro';
import ThemeToggle from '@/components/ThemeToggle.astro';
import { SITE_DESCRIPTION, SITE_NAME } from '@/consts';
import { getLangFromUrl, localizePath, t } from '@/i18n/utils';
import type { Lang, UIKey } from '@/i18n/ui';
import '@/styles/global.css';

interface Props {
  /** Locale of the rendered page. */
  lang: Lang;
  /** Page title without the site suffix. */
  title: string;
  /** Meta description for search engines and social previews. */
  description?: string;
}

const { lang, title, description = SITE_DESCRIPTION } = Astro.props;

const fullTitle = title === SITE_NAME ? title : `${title} · ${SITE_NAME}`;

// Derive the locale from the URL too and warn loudly in dev if a page and its
// layout disagree — that mismatch is otherwise invisible until a human notices
// mixed-language output.
const urlLang = getLangFromUrl(Astro.url);
if (import.meta.env.DEV && urlLang !== lang) {
  console.warn(
    `[i18n] layout lang="${lang}" but URL locale is "${urlLang}" for ${Astro.url.pathname}`,
  );
}

const nav: { key: UIKey; href: string }[] = [
  { key: 'nav.home', href: localizePath('/', lang) },
  { key: 'nav.projects', href: localizePath('/projects/', lang) },
];
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <ThemeScript />
  </head>
  <body>
    <header class="site-header">
      <div class="container site-header__inner">
        <a class="site-header__brand" href={localizePath('/', lang)}>
          <Logo size="sm" />
          <span class="site-header__name">{SITE_NAME}</span>
        </a>
        <nav class="site-nav" aria-label="Main">
          <ul class="site-nav__list">
            {
              nav.map((item) => (
                <li>
                  <a class="site-nav__link" href={item.href}>
                    {t(lang, item.key)}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <div class="site-header__actions">
          <LangSwitcher />
          <ThemeToggle
            labels={{
              toggle: t(lang, 'theme.toggleLabel'),
              toDark: t(lang, 'theme.switchToDark'),
              toLight: t(lang, 'theme.switchToLight'),
            }}
          />
        </div>
      </div>
    </header>
    <main class="page">
      <div class="container">
        <slot />
      </div>
    </main>
    <Footer lang={lang} />
  </body>
</html>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    background-color: var(--bg-subtle);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 4rem;
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
    color: var(--fg);
    text-decoration: none;
  }

  .site-header__brand:hover {
    color: var(--accent);
  }

  .site-header__name {
    /* The wordmark reads as a technical mark, matching the monogram. */
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  /*
   * Narrow screens: logo, nav, language switcher and theme toggle together
   * exceed a phone's width. The wordmark is the one part that carries no
   * information the monogram and the page itself do not already give, so it is
   * the part that goes — dropping it keeps every interactive control and its
   * touch target intact rather than shrinking something tappable.
   */
  @media (max-width: 34rem) {
    .site-header__inner {
      gap: var(--space-2);
    }

    .site-header__name {
      display: none;
    }
  }

  .site-nav {
    margin-inline-end: auto;
  }

  .site-nav__list {
    display: flex;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-nav__link {
    font-size: var(--text-sm);
    color: var(--fg-muted);
    text-decoration: none;
  }

  .site-nav__link:hover {
    color: var(--fg);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
</style>
