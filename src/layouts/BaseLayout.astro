---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import Footer from '@/components/Footer.astro';
import LangSwitcher from '@/components/LangSwitcher.astro';
import Logo from '@/components/Logo.astro';
import ThemeScript from '@/components/ThemeScript.astro';
import ThemeToggle from '@/components/ThemeToggle.astro';
import { SITE_DESCRIPTION, SITE_NAME } from '@/consts';
import { getLangFromUrl, localizePath, t } from '@/i18n/utils';
import { locales, type Lang } from '@/i18n/ui';
import '@/styles/global.css';

interface Props {
  /** Locale of the rendered page. */
  lang: Lang;
  /** Page title without the site suffix. */
  title: string;
  /** Meta description for search engines and social previews. */
  description?: string;
  /**
   * Locales this page actually exists in, emitted as hreflang alternates.
   * Defaults to every locale; a page that may be missing a translation (a
   * project detail page) passes the real list so hreflang never advertises
   * a 404.
   */
  alternates?: Lang[];
  /**
   * Skip the standard centred container wrapper.
   *
   * Opt-in for pages that need an element spanning the full viewport width. The
   * alternative — a child breaking out with `100vw` and a negative margin —
   * either overflows by the scrollbar's width on desktop or, if contained with
   * `overflow: hidden`, silently kills every `position: sticky` inside it. So
   * the page that wants a full-bleed band takes over its own wrapping and adds
   * `.container` per section. Default stays `false` so existing pages are
   * untouched.
   */
  bleed?: boolean;
}

const {
  lang,
  title,
  description = SITE_DESCRIPTION,
  bleed = false,
  alternates = locales,
} = Astro.props;

const fullTitle = title === SITE_NAME ? title : `${title} · ${SITE_NAME}`;

// Fail loudly rather than emit broken SEO tags: canonical, hreflang and og:url
// are absolute and need the configured site origin.
const site = Astro.site;
if (!site) {
  throw new Error('Set `site` in astro.config.mjs — canonical/hreflang/OG URLs need it.');
}

const canonical = new URL(Astro.url.pathname, site);

// Derive the locale from the URL too and warn loudly in dev if a page and its
// layout disagree — that mismatch is otherwise invisible until a human notices
// mixed-language output.
const urlLang = getLangFromUrl(Astro.url);
if (import.meta.env.DEV && urlLang !== lang) {
  console.warn(
    `[i18n] layout lang="${lang}" but URL locale is "${urlLang}" for ${Astro.url.pathname}`,
  );
}

/*
 * No site-wide nav links in the header.
 *
 * The header carries only the brand, the language switcher and the theme
 * toggle; the home page's own "All projects" link and the project pages' back
 * link handle cross-page navigation. A nav here would duplicate those and
 * compete for width on narrow screens. The brand — the monogram plus the name —
 * remains the way back to the home page, so no page is left without a route out.
 */
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <!--
      SEO: one canonical per page, an hreflang pair declaring the two locales
      as translations of each other, and x-default pointing at the `/` stub
      (it is the locale-neutral entry, doing the browser-language detection).
    -->
    <link rel="canonical" href={canonical} />
    {
      alternates.map((alt) => (
        <link
          rel="alternate"
          hreflang={alt}
          href={new URL(localizePath(Astro.url.pathname, alt), site)}
        />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL('/', site)} />

    <!-- Open Graph + Twitter card. One shared 1200×630 image (public/og.png);
         summary_large_image is the card type that renders it full-width. -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'ru' ? 'ru_RU' : 'en_US'} />
    <meta property="og:image" content={new URL('/og.png', site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="FELAGI_DEV — Backend developer, portfolio and selected projects" />
    <meta name="twitter:card" content="summary_large_image" />

    <!--
      Fonts are self-hosted (see the `fonts` block in astro.config.mjs) and
      emitted here, in <head>, before any content is painted.

      Only three files are preloaded — Inter 400 and 600, and JetBrains Mono 600.
      These are the faces above the fold on every page: body copy and headings in
      the first case, the project metric figures in the second.
      Preloading the remaining weights would compete with the CSS and images
      for bandwidth on first load, for text the visitor has not scrolled to yet.
    -->
    <Font
      cssVariable="--font-inter"
      preload={[{ weight: 400 }, { weight: 600 }]}
    />
    <Font
      cssVariable="--font-jetbrains-mono"
      preload={[{ weight: 600 }]}
    />
    <ThemeScript />
    {/*
      View transitions (CP4b). `fallback="swap"` is the graceful path for
      browsers without the View Transitions API: Astro still does the
      client-side navigation, only skipping the animation, so the site never
      depends on the API being present. The default `fade` handles whole-page
      swaps; the list→detail morph is opted into per element with
      `transition:name` + `transition:animate="initial"` (ProjectCard and the
      detail header). Astro's own stylesheet already disables every view
      transition under `prefers-reduced-motion`, so no extra rule is needed here.
    */}
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <header class="site-header">
      <div class="container site-header__inner">
        <a class="site-header__brand" href={localizePath('/', lang)}>
          <Logo />
          <span class="site-header__name">{t(lang, 'home.name')}</span>
          {/*
            The link needs a name that survives at every width. The monogram is
            decorative (`aria-hidden`) and the wordmark is hidden below 34rem, so
            without this the brand would be an unlabelled link on a phone — and
            since the header's nav links were removed, it is the only way back to
            the home page. Visually hidden, so it costs no layout.
          */}
          <span class="sr-only">{t(lang, 'nav.homeLabel')}</span>
        </a>
        <div class="site-header__actions">
          <LangSwitcher />
          <ThemeToggle
            labels={{
              toggle: t(lang, 'theme.toggleLabel'),
              toDark: t(lang, 'theme.switchToDark'),
              toLight: t(lang, 'theme.switchToLight'),
            }}
          />
        </div>
      </div>
    </header>
    <main class="page">
      {
        bleed ? (
          <slot />
        ) : (
          <div class="container">
            <slot />
          </div>
        )
      }
    </main>
    <Footer lang={lang} />
  </body>
</html>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    background-color: var(--bg-subtle);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 4rem;
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
    color: var(--fg);
    text-decoration: none;
  }

  .site-header__brand:hover {
    color: var(--accent);
  }

  .site-header__name {
    /* Brief §5a: the owner's name in Inter 500, not the ASCII product name. */
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-weight: 500;
    letter-spacing: normal;
    white-space: nowrap;
  }

  /*
   * Narrow screens: brand, language switcher and theme toggle together exceed a
   * phone's width. The wordmark is the one part that carries no information the
   * monogram and the page itself do not already give, so it is the part that
   * goes — dropping it keeps every interactive control and its touch target
   * intact rather than shrinking something tappable.
   */
  @media (max-width: 34rem) {
    .site-header__inner {
      gap: var(--space-2);
    }

    .site-header__name {
      display: none;
    }
  }

  /*
   * `margin-inline-end: auto` pushes the actions to the far edge, leaving the
   * brand on the left. This used to sit on the removed `.site-nav`, which was
   * the element between the two.
   */
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-inline-start: auto;
  }
</style>
