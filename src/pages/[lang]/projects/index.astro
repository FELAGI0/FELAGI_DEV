---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { locales, type Lang } from '@/i18n/ui';
import { t } from '@/i18n/utils';
import { getProjectsSorted } from '@/i18n/projects';

export const getStaticPaths = (() =>
  locales.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const { lang } = Astro.params as { lang: Lang };

// Typed end to end: `projects` is `Project[]`, and every field below is
// checked against the collection schema in src/content.config.ts.
const projects = await getProjectsSorted(lang);
---

<BaseLayout lang={lang} title={t(lang, 'projects.title')}>
  <h1>{t(lang, 'projects.title')}</h1>
  <p class="lede">{t(lang, 'projects.intro')}</p>

  {
    projects.length === 0 ? (
      <p>{t(lang, 'projects.empty')}</p>
    ) : (
      <ul class="project-list">
        {projects.map(({ slug, entry }) => (
          <li class="project-card">
            <h2 class="project-card__title">
              <a href={`/${lang}/projects/${slug}/`}>{entry.data.title}</a>
            </h2>

            <p class="project-card__summary">{entry.data.summary}</p>

            <ul class="stack">
              {entry.data.stack.map((tech) => (
                <li class="stack__chip">{tech}</li>
              ))}
            </ul>

            <p class="project-card__meta">
              <span>{entry.data.date}</span>
              <a href={entry.data.repo}>{t(lang, 'projects.repo')}</a>
              {entry.data.demo && (
                <a href={entry.data.demo}>{t(lang, 'projects.demo')}</a>
              )}
            </p>

            {entry.data.demoNote && (
              <p class="project-card__note">{entry.data.demoNote}</p>
            )}
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>

<style>
  .lede {
    max-width: 60ch;
    font-size: var(--text-lg);
  }

  .project-list {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-8);
    padding: 0;
    list-style: none;
  }

  .project-card {
    padding: var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }

  .project-card__title {
    margin-bottom: var(--space-2);
    font-size: var(--text-xl);
  }

  .project-card__title a {
    color: var(--fg);
    text-decoration: none;
  }

  .project-card__title a:hover {
    color: var(--accent);
  }

  .project-card__summary {
    max-width: 65ch;
    margin-bottom: var(--space-4);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-4);
    padding: 0;
    list-style: none;
  }

  .stack__chip {
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--fg-muted);
  }

  .project-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin: 0;
    font-size: var(--text-sm);
  }

  .project-card__note {
    margin: var(--space-2) 0 0;
    font-size: var(--text-sm);
    color: var(--fg-subtle);
  }
</style>