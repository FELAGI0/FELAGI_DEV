---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { locales, type Lang } from '@/i18n/ui';
import { t } from '@/i18n/utils';
import { getProjectsSorted } from '@/i18n/projects';

export const getStaticPaths = (() =>
  locales.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const { lang } = Astro.params as { lang: Lang };

// Typed end to end: `projects` is `Project[]`, and every field the card reads
// is checked against the collection schema in src/content.config.ts.
const projects = await getProjectsSorted(lang);
---

<BaseLayout lang={lang} title={t(lang, 'projects.title')}>
  <h1>{t(lang, 'projects.title')}</h1>
  <p class="lede">{t(lang, 'projects.intro')}</p>

  {
    projects.length === 0 ? (
      <p>{t(lang, 'projects.empty')}</p>
    ) : (
      <ul class="project-list">
        {projects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </ul>
    )
  }
</BaseLayout>

<style>
  .lede {
    max-width: 60ch;
    font-size: var(--text-lg);
  }

  /* Base grid comes from `.project-list` in global.css; only the gap below
     the intro line is this page's own. */
  .project-list {
    margin-top: var(--space-8);
  }
</style>
