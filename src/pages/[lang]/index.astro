---
/**
 * Home page (brief §6): hero, stack marquee, selected projects, about,
 * principles, skills and contacts.
 *
 * Every section's text comes from `src/i18n/ui.ts`; technology names come from
 * `src/consts.ts`. Nothing user-facing is hardcoded here, so adding a language
 * is a dictionary edit rather than a template edit.
 *
 * About and Principles use a two-column layout with a sticky heading, which
 * needs its own markup rather than `<Section>`'s single-column slot — see the
 * `.split` rules at the bottom of this file.
 */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Marquee from '@/components/Marquee.astro';
import PrincipleItem from '@/components/PrincipleItem.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import Section from '@/components/Section.astro';
import SkillCard from '@/components/SkillCard.astro';
import Terminal from '@/components/Terminal.astro';
import { CONTACTS, OWNER_HANDLE, SKILL_GROUPS, STACK } from '@/consts';
import { getFeaturedProjects } from '@/i18n/projects';
import { locales, type Lang, type UIKey } from '@/i18n/ui';
import { t } from '@/i18n/utils';

export const getStaticPaths = (() =>
  locales.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const { lang } = Astro.params as { lang: Lang };

/** Show at most this many featured projects on the home page. */
const MAX_FEATURED = 3;

const featured = (await getFeaturedProjects(lang)).slice(0, MAX_FEATURED);

const principleKeys: UIKey[] = [
  'principles.1',
  'principles.2',
  'principles.3',
  'principles.4',
];

const projectsHref = `/${lang}/projects/`;

/**
 * The hero's role line, split into words so each can animate in on its own.
 *
 * Split at build time rather than in the browser: the words are plain text in
 * the HTML, so they are readable (and indexable) before any script runs — a
 * client-side split would leave the heading empty until hydration. The reveal
 * itself is a CSS animation, so no JavaScript is involved at all.
 */
const roleWords = t(lang, 'home.role').split(' ');
---

<BaseLayout lang={lang} title="FELAGI_DEV" bleed>
  <div class="container">
    <!-- Hero -->
    <div class="hero">
      <div class="hero__body">
        <p class="hero__name">
          {t(lang, 'home.name')} · <span class="hero__handle">{OWNER_HANDLE}</span>
        </p>
        <h1 class="hero__role">
          {
            roleWords.map((word, i) => (
              <>
                <span class="hero__word" style={`--word-index: ${i}`}>{word}</span>
                {i < roleWords.length - 1 ? ' ' : ''}
              </>
            ))
          }
        </h1>
        <p class="hero__stack">{STACK.slice(0, 3).join(' · ')}</p>
        <p class="hero__tagline">{t(lang, 'home.tagline')}</p>
        <a class="hero__cta" href={projectsHref}>{t(lang, 'projects.title')}</a>
      </div>
      <div class="hero__mark">
        <Terminal />
      </div>
    </div>

    <!-- Stack marquee -->
    <div class="marquee-wrap">
      <Marquee />
    </div>
  </div>

  <!--
    Selected projects: a full-bleed band.
    The section spans the viewport (the layout's bleed mode hands us the
    undivided <main>), while its contents stay on the same 1360px grid as
    everything else by sitting in a `.container` of their own. A slightly
    lighter background separates it from the hero above and the sections below
    without a second border.
  -->
  <section class="band" id="projects" aria-labelledby="projects-title">
    <div class="container">
      <h2 class="section__title" id="projects-title">
        {t(lang, 'home.selected.title')}
      </h2>

      {
        featured.length > 0 ? (
          <ul class="project-list">
            {featured.map((project) => (
              <ProjectCard project={project} />
            ))}
          </ul>
        ) : (
          <p>{t(lang, 'projects.empty')}</p>
        )
      }

      <p class="section-more">
        <a class="section-more__link" href={projectsHref}>
          <span class="section-more__label">{t(lang, 'home.selected.all')}</span>
          <span class="section-more__arrow" aria-hidden="true">→</span>
        </a>
      </p>
    </div>
  </section>

  <!--
    The four sections below the fold, each wrapped in `<Section>` or written by
    hand (About and Principles need the two-column split markup). The `.sections`
    wrapper exists only to scope the split's desktop collapse — see the style
    block at the bottom of this file.
  -->
  <div class="container sections">
    <!-- About: two columns, sticky heading on the left -->
    <section class="section split" id="about" aria-labelledby="about-title">
      <h2 class="section__title split__title" id="about-title">
        {t(lang, 'nav.home')}
      </h2>
      <div class="split__body">
        <p class="lead">{t(lang, 'about.p1')}</p>
        <p class="lead">{t(lang, 'about.p2')}</p>
      </div>
    </section>

    <!-- Principles: same two-column shape -->
    <section
      class="section split"
      id="principles"
      aria-labelledby="principles-title"
    >
      <h2 class="section__title split__title" id="principles-title">
        {t(lang, 'principles.title')}
      </h2>
      <div class="split__body">
        <ol class="principles">
          {
            principleKeys.map((key, i) => (
              <PrincipleItem index={i + 1} text={t(lang, key)} />
            ))
          }
        </ol>
      </div>
    </section>

    <!-- Skills -->
    <Section id="skills" title={t(lang, 'skills.title')}>
      <ul class="skills">
        {
          SKILL_GROUPS.map((group) => (
            <SkillCard lang={lang} labelKey={group.labelKey} items={group.items} />
          ))
        }
      </ul>
    </Section>

    <!-- Contacts -->
    <Section id="contacts" title={t(lang, 'contacts.title')}>
      <p>{t(lang, 'contacts.note')}</p>
      <ul class="contacts">
        {
          CONTACTS.map((contact) => (
            <li class="contacts__item">
              <a class="contacts__link" href={contact.href}>
                {contact.label}
              </a>
            </li>
          ))
        }
      </ul>
    </Section>
  </div>

  <!--
    Show the sections already on screen before first paint.

    The reveal CSS hides every unit from first paint, but the motion script
    below is a bundled (deferred) module and may run after the browser has
    painted — which would flash an empty first screen before the module reveals
    what is already in view. An inline script runs during parsing, before paint,
    so the first screen is simply present. It needs no unit list: adding
    `is-revealed` to the section flips every unit through the CSS alone, and
    `data-reveal-instant` drops the transition so nothing animates on load.

    The module repeats this (idempotently) so it also holds after a
    ClientRouter navigation, where this inline script may not re-run.
  -->
  <script is:inline>
    (function () {
      if (document.documentElement.dataset.motion !== 'ok') return;
      var line = window.innerHeight * 0.85;
      var sections = document.querySelectorAll('.section, .band');
      for (var i = 0; i < sections.length; i++) {
        if (sections[i].getBoundingClientRect().top < line) {
          sections[i].dataset.revealInstant = '';
          sections[i].classList.add('is-revealed');
        }
      }
    })();
  </script>

  <!--
    Cursor spotlight (CP4b): a decorative layer whose gradient follows the
    pointer. Empty and inert by default — see `.spotlight` below and the script
    at the end of the file. `aria-hidden` because it carries no information.
  -->
  <div class="spotlight" aria-hidden="true"></div>
</BaseLayout>

<script>
  /*
   * Home-page motion (CP4b), in one script with one IntersectionObserver.
   *
   * Both features are gated on `<html data-motion="ok">`, which the pre-paint
   * theme script sets only when the visitor has not asked for reduced motion.
   * With the gate off this script does nothing at all: no observer, no pointer
   * listener. That keeps the "reduced motion ⇒ static page" promise in one
   * place (the gate) rather than spread across a media query per feature.
   *
   * The script is re-run on `astro:page-load` because a bundled script executes
   * once — after a ClientRouter navigation to another page and back, the new
   * DOM would otherwise have no observer or listener bound.
   */
  function setupHomeMotion(): void {
    if (document.documentElement.dataset.motion !== 'ok') return;

    /* ---- Stagger reveal, per element ---- */

    /*
     * Which elements inside a section animate, in document order. MUST mirror
     * the selector in global.css — that rule hides exactly these, and the reveal
     * here is what shows them again. A unit listed in the CSS but not here would
     * stay hidden forever.
     *
     * Per element, not one block per section: a paras-worth of items cascading
     * one after another is what is actually legible as motion.
     */
    const REVEAL_UNITS = [
      '.section__title',
      '.section > p',
      '.split__body > p',
      '.principles > li',
      '.skills > li',
      '.contacts > li',
      '.project-list',
      '.section-more',
    ].join(',');

    /** Delay between consecutive units, a little under the 550ms duration. */
    const STAGGER_MS = 100;

    const sections = document.querySelectorAll<HTMLElement>('.section, .band');

    /**
     * Write the per-unit delays and hand the section its revealed state.
     * `instant` skips the cascade (delay 0, no transition) for a section that is
     * already on screen when the page loads — the first screen should simply be
     * there, not animate itself in.
     */
    function reveal(section: HTMLElement, instant: boolean): void {
      const units = section.querySelectorAll<HTMLElement>(REVEAL_UNITS);
      let i = 0;
      for (const unit of units) {
        unit.style.setProperty('--reveal-delay', `${instant ? 0 : i * STAGGER_MS}ms`);
        i += 1;
      }
      if (instant) {
        section.dataset.revealInstant = '';
        section.classList.add('is-revealed');
        return;
      }
      // Held to the next frame because the delays were only just written —
      // setting them and the class in one tick can batch both into a single
      // style recalculation, and the transition is skipped.
      requestAnimationFrame(() => section.classList.add('is-revealed'));
    }

    /**
     * True when the section is at or above the observer's trigger line, so the
     * observer would fire (or has passed it) — show it at once instead of
     * observing. Covers three cases with one test: a section in view at load, a
     * section half in view, and a section above the viewport on a restored
     * scroll position (which would otherwise stay hidden until scrolled back to).
     * The line is `vh * (1 - 0.15)`, mirroring the `rootMargin` below.
     */
    function atOrAboveTrigger(section: HTMLElement): boolean {
      return section.getBoundingClientRect().top < window.innerHeight * 0.85;
    }

    const revealObserver = new IntersectionObserver(
      (entries, observer) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          reveal(entry.target as HTMLElement, false);
          observer.unobserve(entry.target);
        }
      },
      // `rootMargin` shrinks the viewport by 15% at the bottom, so a section
      // that is merely peeking does not trigger before it is being read.
      // `threshold: 0.15` requires a further 15% of the section itself to be
      // inside that box, so the reveal waits until the section is genuinely on
      // screen rather than the instant its first pixel crosses the line. The
      // shortest section measured still reaches a 0.63 ratio inside the box at
      // the narrowest viewport, so this threshold is always reachable.
      { rootMargin: '0px 0px -15% 0px', threshold: 0.15 },
    );

    for (const section of sections) {
      if (atOrAboveTrigger(section)) reveal(section, true);
      else revealObserver.observe(section);
    }

    /* ---- Cursor spotlight ---- */

    const spotlight = document.querySelector<HTMLElement>('.spotlight');
    if (spotlight) {
      let raf = 0;
      let px = 0;
      let py = 0;

      function apply(): void {
        raf = 0;
        spotlight!.style.setProperty('--spot-x', `${px}px`);
        spotlight!.style.setProperty('--spot-y', `${py}px`);
        spotlight!.classList.add('is-on');
      }

      window.addEventListener(
        'pointermove',
        (event) => {
          px = event.clientX;
          py = event.clientY;
          // Coalesce to one style write per frame — pointermove outpaces paint.
          if (!raf) raf = requestAnimationFrame(apply);
        },
        { passive: true },
      );
    }
  }

  // Runs on first load and after every ClientRouter navigation. The reveal
  // observer unobserves each section once revealed, and a fresh page brings
  // fresh sections, so a new observer per call is correct and leaks nothing.
  setupHomeMotion();
  document.addEventListener('astro:page-load', setupHomeMotion);
</script>

<style>
  /* Hero */
  .hero {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    /* Matches the section rhythm: 64px mobile, 96px desktop. */
    padding-block: var(--space-16);
  }

  @media (min-width: 48rem) {
    .hero {
      padding-block: var(--space-24);
    }
  }

  .hero__name {
    margin-bottom: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  /* Brief §3: the handle is JetBrains Mono 0.9375rem, tracking 0.02em. */
  .hero__handle {
    font-family: var(--font-mono);
    font-size: var(--text-muted);
    font-weight: 400;
    letter-spacing: var(--tracking-wide);
    color: var(--fg-subtle);
    text-transform: none;
  }

  /*
   * No `font-size` here: the hero heading is an `h1`, and brief §3 sizes it via
   * the global rule (clamp 2.5rem → 5rem, 1.05 leading). An earlier checkpoint
   * pinned it to `--text-2xl`, which silently made the page's main heading the
   * same size as a section heading and defeated the hero scale.
   */
  .hero__role {
    letter-spacing: var(--tracking-tight);
  }

  .hero__stack {
    margin-bottom: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-chip);
    color: var(--fg-muted);
  }

  .hero__tagline {
    max-width: 55ch;
    margin-bottom: var(--space-6);
    /*
     * Left at 18px, not the 17px the CP4c3 note asked for.
     *
     * The note assumed this line was 1rem; it has been `--text-lg` (18px) since
     * CP4a. Forcing 17px would have *shrunk* it, against that block's own goal
     * of making type larger — and it would have put the tagline at exactly the
     * same size as the About paragraphs, flattening the step between the hero's
     * summary line and body copy. Kept one step above `--text-lead`.
     */
    font-size: var(--text-lg);
    color: var(--fg);
  }

  .hero__cta {
    display: inline-block;
    padding: var(--space-3) var(--space-6);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--fg);
    text-decoration: none;
  }

  .hero__cta:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .hero__mark {
    flex: none;
    width: 100%;
    max-width: 26rem;
  }

  /*
   * Narrow screens: the panel moves below the copy and narrows to the container
   * instead of being dropped.
   *
   * The previous occupant of this slot was the large monogram, which was
   * decorative and space-hungry enough to be hidden on phones. The terminal is
   * still decorative, but it is also the only concrete evidence of the stack on
   * first screen, so it stacks under the text rather than disappearing. It is
   * pinned to `max-width: 100%` so it can never exceed the container.
   */
  @media (max-width: 48rem) {
    .hero {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-8);
    }

    .hero__mark {
      max-width: 100%;
    }
  }

  /* Marquee sits between the hero and the first section, so it brings its own
     spacing rather than relying on `.section + .section`. */
  .marquee-wrap {
    padding-block: var(--space-8);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  /* Shared list layouts */
  .project-list {
    display: grid;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /*
   * Two cards side by side from 1280px up.
   *
   * The band is full-bleed, so at that width each card gets roughly 640px —
   * enough that the summary sits on two lines instead of four. Below 1280px a
   * single column is kept: two ~470px columns would wrap the summary into a
   * paragraph too narrow to scan.
   */
  @media (min-width: 80rem) {
    .project-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /*
   * Full-bleed band for Selected projects.
   *
   * The layout's `bleed` mode removes the outer container, so this section spans
   * the viewport while its own `.container` keeps the contents aligned to the
   * same 1360px grid as every other section.
   *
   * Depth comes from a vignette, not a flat fill: an inset shadow darkens the
   * edges toward the page colour while the centre keeps full `--bg-subtle`, so
   * the band reads as a lit surface. An inset shadow rather than a radial
   * gradient because the project rules radial gradients out as a cliché.
   *
   * Sized in `vw`, not px: the band is full-bleed, so its width is the viewport
   * width. A fixed 160px shadow reaches 160px in from each edge, which on a
   * 360px phone is the whole band — the centre would never be clear, defeating
   * the vignette. `12vw` keeps the clear centre proportional at every width.
   *
   * The shadow colour is a literal (a one-off) but differs per theme, because
   * the two themes have very different tonal room:
   *   - Dark: band #141414 (rgb 20) sits only 10 levels above the page #0a0a0a
   *     (rgb 10). A strong black lands the edge at the page colour, so the band
   *     dissolves into the page — the largest depth the palette allows. Measured
   *     centre↔edge contrast 1.075 (rgb 20 → 10).
   *   - Light: band #f5f5f5 (rgb 245) on a white page has far more room; a much
   *     lighter black gives a clear but not muddy frame. Measured 1.415
   *     (rgb 245 → 208).
   */
  .band {
    padding-block: var(--space-16);
    background-color: var(--bg-subtle);
    box-shadow: inset 0 0 12vw 1.5vw rgb(0 0 0 / 0.5);
    border-block: 1px solid var(--border);
  }

  :global([data-theme='light']) .band {
    box-shadow: inset 0 0 12vw 1.5vw rgb(0 0 0 / 0.15);
  }

  @media (min-width: 48rem) {
    .band {
      padding-block: var(--space-24);
    }
  }

  /*
   * Two-column section: heading left, content right.
   *
   * Columns are `auto` + `1fr` rather than fixed fractions, so the heading takes
   * exactly the width its longest word needs ("Infrastructure" is wider than
   * "About") and the body gets everything else. That keeps the two split
   * sections visually aligned without hard-coding a column width per section.
   *
   * The heading is sticky so it stays in view while a long body scrolls past —
   * a small reading aid, not a page-wide sidebar. It only applies from 768px up,
   * where there are two columns to stick between.
   */
  @media (min-width: 48rem) {
    .split {
      display: grid;
      grid-template-columns: minmax(10rem, 16rem) 1fr;
      gap: var(--space-12);
      align-items: start;
    }

    .split__title {
      position: sticky;
      top: var(--space-8);
      margin-bottom: 0;
    }
  }

  /*
   * From 1024px the section headings move back above their bodies.
   *
   * The split's two-column shape costs a 16rem heading column, which at this
   * width spends a sixth of the row on a two-word heading; above the body reads
   * better as the container-width column it is. Scoped through `.sections` so
   * the rule targets the home page's run of sections and not the split layout
   * anywhere else it might appear.
   */
  @media (min-width: 64rem) {
    .sections .split {
      display: block;
    }

    .sections .split__title {
      position: static;
      margin-bottom: var(--space-6);
    }
  }

  .split__body > :last-child {
    margin-bottom: 0;
  }

  /*
   * Skills: three cards, each only as wide as its own content needs.
   *
   * A fixed three-column grid would stretch "Frontend" (2 items) to the same
   * width as "Backend" (6 items) and produce the uniform tiles the brief rules
   * out. `flex` with content-sized items lets each card be as wide as it is
   * dense, and the row simply ends where the content does.
   *
   * CP4c5 made the cards grow to fill the row; that is reverted. Stretching them
   * flattened the density difference the cards exist to show — a three-item
   * group ended up nearly as wide as a six-item one — so the widths are content
   * driven again and the row is allowed to end early.
   */
  .skills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /*
   * From 1024px the three cards stay on one row.
   *
   * `nowrap` with the cards' default `flex-shrink: 1` means they tighten to fit
   * the column when it is narrow, but never grow: at 1440px their natural widths
   * already fit, so they keep the density they were sized for. Growing them (the
   * CP4c5 behaviour) is what flattened the difference between a two-item and a
   * six-item group.
   */
  @media (min-width: 64rem) {
    .skills {
      flex-wrap: nowrap;
    }
  }

  /*
   * "All projects →" spans the section's content width with the arrow pushed to
   * the far edge — a full-width affordance rather than a small inline link that
   * is easy to miss at the end of a row of cards.
   *
   * The arrow is a separate element from the label precisely so it can be sent
   * to the opposite edge; as part of the link text it would always sit directly
   * after the words.
   */
  .section-more {
    margin: 0;
  }

  .section-more__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-4); /* 16px */
    font-size: var(--text-base); /* 16px */
    color: var(--accent);
    text-decoration: none;
  }

  /*
   * Underline appears on hover rather than being always on: the link already
   * reads as interactive by spanning the row and carrying the accent colour, so
   * a permanent underline would only add noise.
   */
  .section-more__link:hover .section-more__label {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /*
   * The arrow nudges right on hover. `transform` rather than a margin change so
   * it cannot reflow the row, and it is a pointer reaction, not an animation.
   */
  .section-more__arrow {
    transition: transform var(--transition);
  }

  .section-more__link:hover .section-more__arrow {
    transform: translateX(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .section-more__arrow {
      transition: none;
    }

    .section-more__link:hover .section-more__arrow {
      transform: none;
    }
  }

  .principles {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contacts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /*
   * Contact links are bordered targets rather than bare text.
   *
   * Kept from CP4c5 deliberately: the rollback covers About, Principles and
   * Skills, and this section has the opposite problem — measured, it was the
   * emptiest on the page (content filled 42% of its height) with the smallest
   * interactive text at 14px. The border, padding and 15px mono type add density
   * where it was missing and grow the touch target of the links the page exists
   * to deliver. Colour stays on the global `a` rule, so the palette is unchanged.
   */
  .contacts__link {
    display: inline-block;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: 0.9375rem; /* 15px */
    text-decoration: none;
    transition:
      border-color var(--transition),
      color var(--transition);
  }

  .contacts__link:hover {
    border-color: var(--accent);
  }

  /*
   * CP4b — hero split-text.
   *
   * Each word is its own inline-block so it can be transformed; the spaces
   * between them are literal text nodes in the markup, so the line still wraps
   * on word boundaries as normal. The animation runs once on load here, not on
   * scroll, and is gated on `[data-motion='ok']` — with reduced motion the words
   * are plain, static text.
   */
  .hero__word {
    display: inline-block;
  }

  /*
   * `:global()` on the ancestor is required: `data-motion` lives on `<html>`,
   * which carries no scoping id, so a plain descendant selector would compile
   * to `[data-astro-cid-…][data-motion='ok']…` and never match. Same pattern as
   * the theme-scoped rules in Terminal.astro.
   */
  :global([data-motion='ok']) .hero__word {
    animation: hero-word 400ms ease-out both;
    animation-delay: calc(var(--word-index, 0) * 60ms);
  }

  @keyframes hero-word {
    from {
      opacity: 0;
      transform: translateY(0.6em);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /*
   * CP4b — cursor spotlight.
   *
   * A fixed, full-viewport layer whose radial gradient is centred on the
   * pointer via `--spot-x` / `--spot-y` (set by the script). It sits at
   * `z-index: -1`, the same layer as the background grid: above the page
   * background, below every in-flow element, so it can never sit over text.
   * `pointer-events: none` keeps it out of the way of clicks.
   *
   * Radius 14rem (224px), down from 28rem (448px): at 448px the glow read as a
   * wash over half the viewport rather than a highlight around the pointer. The
   * gradient is opaque out to 65% (≈146px) and fades to the edge, so the visible
   * core is roughly a 290px disc. Area drops from ~630k px² to ~158k px², about
   * 4× less.
   *
   * Opacity stays 0.07 — under the 0.08 ceiling, and on its own it was not the
   * problem, so the fix is the radius, not the alpha.
   */
  .spotlight {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    opacity: 0;
    transition: opacity 400ms ease;
    background: radial-gradient(
      14rem circle at var(--spot-x, 50%) var(--spot-y, 40%),
      var(--accent),
      transparent 65%
    );
  }

  .spotlight.is-on {
    opacity: 0.07;
  }
</style>
