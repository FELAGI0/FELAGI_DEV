---
/**
 * Monogram: a dark rounded square holding a single "F" (brief §5).
 *
 * The square is always `#0a0a0a` and the letter always `#e5e5e5`, in both
 * themes. These are literals rather than design tokens on purpose: the mark is
 * a fixed brand asset, not a themed surface. If it followed `--bg`, the light
 * theme would turn it into a white square with dark text and it would stop
 * being the same logo.
 *
 * The SVG is decorative (`aria-hidden`). In the header it sits inside the brand
 * link, and in the hero it sits next to the name, so the accessible name comes
 * from that surrounding text; giving the mark its own `<title>` would make a
 * screen reader announce the name twice.
 */

/** Rendered edge length: the brief's 32px header size, with a 12px radius. */
const px = 32;
const radius = 12;

/** Letter occupies ~55% of the square's edge (brief §5). */
const letterSize = Math.round(px * 0.55);
---

<svg
  class="logo"
  width={px}
  height={px}
  viewBox={`0 0 ${px} ${px}`}
  aria-hidden="true"
  focusable="false"
>
  <rect width={px} height={px} rx={radius} fill="#0a0a0a" />
  <text
    class="logo__letter"
    x="50%"
    y="50%"
    text-anchor="middle"
    dominant-baseline="central"
    font-size={letterSize}
    fill="#e5e5e5">F</text
  >
</svg>

<style>
  .logo {
    display: block;
    flex: none;
  }

  .logo__letter {
    /*
     * Only the variable, no literal family name.
     *
     * Astro's Fonts API registers each family under a *hashed* name
     * (`JetBrains Mono-f7b85374b7aa8895`) to keep it from colliding with a
     * locally installed font of the same name, and exposes it through
     * `--font-jetbrains-mono` together with its size-adjusted fallbacks.
     * Spelling `'JetBrains Mono'` first — as this rule used to — never matches
     * anything, so the browser silently skipped to the next entry; it also
     * duplicated the fallback chain that the variable already carries.
     */
    font-family: var(--font-mono);
    font-weight: 700;
  }
</style>
