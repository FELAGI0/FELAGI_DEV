---
/**
 * Theme bootstrap. Must run synchronously, before first paint, so the
 * page never flashes the wrong theme. `is:inline` keeps it out of the
 * bundler and in <head> exactly where it is written.
 *
 * Resolution order, matching the spec exactly:
 *   1. `localStorage.theme` — an explicit choice the visitor made earlier
 *   2. `prefers-color-scheme` — the OS preference
 *   3. `'dark'` — the fallback when the OS expresses no preference
 *
 * Dark is the *default*, not an override: a visitor whose OS asks for light
 * gets light. `<html data-theme="dark">` is baked into the markup, so for the
 * common dark case this script changes nothing at all.
 */
const THEME_SCRIPT = `
(function () {
  var KEY = 'theme';
  var root = document.documentElement;

  function apply() {
    var stored = null;
    try { stored = localStorage.getItem(KEY); } catch (e) { stored = null; }

    var theme;
    if (stored === 'light' || stored === 'dark') {
      theme = stored;
    } else if (
      window.matchMedia &&
      window.matchMedia('(prefers-color-scheme: light)').matches
    ) {
      theme = 'light';
    } else {
      theme = 'dark';
    }

    root.dataset.theme = theme;
    root.style.colorScheme = theme;

    /*
     * Motion gate for CP4b animations, set here so it is known before first
     * paint (a reveal must not flash visible-then-hidden).
     *
     * 'ok' only when the visitor has not asked for reduced motion. The animation
     * rules are written as [data-motion='ok'] …, so with reduced motion — or
     * with JS off, where this never runs — nothing is ever hidden and the page
     * is simply static. This reuses the one pre-paint script rather than adding
     * another prefers-reduced-motion media block.
     */
    var reduce = false;
    try {
      reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    } catch (e) { reduce = false; }
    if (reduce) {
      delete root.dataset.motion;
    } else {
      root.dataset.motion = 'ok';
    }
  }

  apply();

  /*
   * Client-side navigations (ClientRouter) swap the document *and* reset
   * <html>'s attributes and classes, so the theme, the motion gate and the
   * theme-ready transition gate are all lost on every transition. Re-apply them
   * right after the swap, before the new page paints, so none of the three
   * flashes wrong.
   *
   * theme-ready is re-added here rather than inside apply() because on the
   * initial load apply() runs before first paint, where the class must still be
   * absent — that is exactly what READY_SCRIPT below defers with a rAF. By an
   * after-swap there has already been a paint, so adding it immediately is right.
   */
  document.addEventListener('astro:after-swap', function () {
    apply();
    root.classList.add('theme-ready');
  });
})();
`;

/**
 * Enables color transitions only after the first paint, so the initial
 * render is not animated.
 */
const READY_SCRIPT = `
requestAnimationFrame(function () {
  document.documentElement.classList.add('theme-ready');
});
`;
---

<script is:inline set:html={THEME_SCRIPT} />
<script is:inline set:html={READY_SCRIPT} />
