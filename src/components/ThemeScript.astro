---
/**
 * Theme bootstrap. Must run synchronously, before first paint, so the
 * page never flashes the wrong theme. `is:inline` keeps it out of the
 * bundler and in <head> exactly where it is written.
 *
 * Resolution order, matching the spec exactly:
 *   1. `localStorage.theme` — an explicit choice the visitor made earlier
 *   2. `prefers-color-scheme` — the OS preference
 *   3. `'dark'` — the fallback when the OS expresses no preference
 *
 * Dark is the *default*, not an override: a visitor whose OS asks for light
 * gets light. `<html data-theme="dark">` is baked into the markup, so for the
 * common dark case this script changes nothing at all.
 */
const THEME_SCRIPT = `
(function () {
  var KEY = 'theme';
  var root = document.documentElement;
  var stored = null;
  try { stored = localStorage.getItem(KEY); } catch (e) { stored = null; }

  var theme;
  if (stored === 'light' || stored === 'dark') {
    theme = stored;
  } else if (
    window.matchMedia &&
    window.matchMedia('(prefers-color-scheme: light)').matches
  ) {
    theme = 'light';
  } else {
    theme = 'dark';
  }

  root.dataset.theme = theme;
  root.style.colorScheme = theme;
})();
`;

/**
 * Enables color transitions only after the first paint, so the initial
 * render is not animated.
 */
const READY_SCRIPT = `
requestAnimationFrame(function () {
  document.documentElement.classList.add('theme-ready');
});
`;
---

<script is:inline set:html={THEME_SCRIPT} />
<script is:inline set:html={READY_SCRIPT} />
