---
import { getLangFromUrl, localizePath, otherLangs, t } from '@/i18n/utils';
import { languages, type Lang } from '@/i18n/ui';

/**
 * Links to *this same page* in every other locale, so switching language keeps
 * the visitor where they are instead of dumping them on the home page.
 * With `prefixDefaultLocale: true` every URL has a locale segment, so the swap
 * is a straight path rewrite.
 *
 * Query string and fragment cannot be baked into the static HTML: the page is
 * prerendered once at build time, where `Astro.url` carries no request query.
 * A tiny inline script appends the visitor's current `location.search` and
 * `location.hash` to these links in the browser, which keeps `?tag=x#top`
 * alive across a language switch. The server-rendered href stays correct for
 * crawlers and for visitors without JS.
 */
const current: Lang = getLangFromUrl(Astro.url);
const targets = otherLangs(current).map((locale) => ({
  locale,
  label: languages[locale],
  href: localizePath(Astro.url.pathname, locale),
}));
---

<nav class="lang-switcher" aria-label={t(current, 'lang.switchLabel')}>
  <ul class="lang-switcher__list">
    {
      targets.map((target) => (
        <li>
          <a
            class="lang-switcher__link"
            href={target.href}
            hreflang={target.locale}
            lang={target.locale}
            rel="alternate"
          >
            {target.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  /*
   * Carry the current query string and fragment onto the language links.
   * Done here rather than in the template because these pages are static:
   * there is no request-time URL to read during the build.
   *
   * Re-run on `astro:page-load` (which also fires on the first load): a bundled
   * script executes only once, so after a ClientRouter navigation the freshly
   * swapped-in links would otherwise lose the suffix. `astro:page-load` fires
   * once the new page is in the DOM, so the links it targets are the current
   * ones.
   */
  function carrySuffixToLangLinks(): void {
    const suffix = `${window.location.search}${window.location.hash}`;
    if (!suffix) return;

    for (const link of document.querySelectorAll<HTMLAnchorElement>(
      '.lang-switcher__link',
    )) {
      // Read/write the attribute rather than the `pathname` property, so the
      // href stays site-relative instead of being expanded to an absolute URL.
      const href = link.getAttribute('href');
      if (href && !href.endsWith(suffix)) {
        link.setAttribute('href', href + suffix);
      }
    }
  }

  // Called immediately as well: `astro:page-load` only fires when the
  // ClientRouter is present, and without it this script must still run once on
  // load. The `endsWith` guard above makes the two paths safe to both run.
  carrySuffixToLangLinks();
  document.addEventListener('astro:page-load', carrySuffixToLangLinks);
</script>

<style>
  .lang-switcher__list {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lang-switcher__link {
    display: inline-block;
    padding: var(--space-1) var(--space-3);
    border: 1px solid transparent;
    border-radius: var(--radius);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--fg-muted);
    text-decoration: none;
  }

  .lang-switcher__link:hover {
    color: var(--fg);
    border-color: var(--border-strong);
  }
</style>
