---
/**
 * A single project card (brief §10).
 *
 * Extracted from the projects list so the same markup can be reused on the home
 * page's "selected projects" block. `project` is the typed object from
 * `src/i18n/projects.ts`, so every field below is checked against the
 * collection schema at build time.
 *
 * The whole card is not one link: it contains three separate destinations
 * (detail page, repo, demo). Wrapping them in a single anchor would nest links,
 * which is invalid HTML and unusable with a keyboard.
 *
 * Renders an `<li>`: the card is only ever used inside a `<ul>` list of
 * projects, so the list element belongs to the component rather than being
 * repeated by every caller.
 */
import type { Project } from '@/i18n/projects';
import { t } from '@/i18n/utils';

interface Props {
  /** The project to render, with its slug, locale and validated data. */
  project: Project;
}

const { project } = Astro.props;
const { slug, lang, entry } = project;
const { data } = entry;

const detailHref = `/${lang}/projects/${slug}/`;
---

<li class="project-card">
  {/*
    The title morphs into the detail page's heading. `transition:name` is keyed
    by slug so the pair is unique on a page with several cards, and
    `transition:animate="initial"` opts this element into Astro's morph instead
    of the default crossfade. See the matching name on the detail page.
  */}
  <h2
    class="project-card__title"
    transition:name={`project-title-${slug}`}
    transition:animate="initial"
  >
    <a href={detailHref}>{data.title}</a>
  </h2>

  <p class="project-card__summary">{data.summary}</p>

  <ul class="stack">
    {
      data.stack.map((tech) => (
        <li class="stack__chip">{tech}</li>
      ))
    }
  </ul>

  {
    /* Headline figure: rendered only when the frontmatter provides one. */
    data.metric && (
      <p class="project-card__metric">
        <span class="project-card__metric-value">{data.metric.value}</span>
        <span class="project-card__metric-label">{data.metric.label}</span>
      </p>
    )
  }

  <p class="project-card__meta">
    <span class="project-card__lang">{data.stack[0]}</span>
    <span class="project-card__date">{data.date}</span>
    <a href={data.repo}>{t(lang, 'projects.repo')}</a>
    {data.demo && <a href={data.demo}>{t(lang, 'projects.demo')}</a>}
  </p>

  {data.demoNote && <p class="project-card__note">{data.demoNote}</p>}
</li>

<style>
  .project-card {
    padding: var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    /*
     * Pointer + lift on hover. This is a CSS transition, not an animation: it
     * reacts to the pointer being over the card and is over in 150ms. Motion
     * that runs on its own belongs to CP4b.
     */
    transition:
      border-color var(--transition),
      transform var(--transition);
  }

  .project-card:hover {
    border-color: var(--border-strong);
    transform: translateY(-2px);
  }

  /*
   * Respect a reduced-motion preference: keep the border cue (it is not motion)
   * and drop the movement.
   */
  @media (prefers-reduced-motion: reduce) {
    .project-card:hover {
      transform: none;
    }
  }

  .project-card__title {
    margin-bottom: var(--space-2);
    font-size: var(--text-xl);
  }

  .project-card__title a {
    color: var(--fg);
    text-decoration: none;
  }

  .project-card__title a:hover {
    color: var(--accent);
  }

  .project-card__summary {
    max-width: 65ch;
    margin-bottom: var(--space-4);
  }

  /* `.stack` and `.stack__chip` come from global.css — shared with the detail page. */

  /*
   * The headline figure. Both parts sit on one baseline so the number reads as
   * the primary element and the unit as its label, rather than as two pieces of
   * text at the same weight.
   */
  .project-card__metric {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    margin: 0 0 var(--space-4);
  }

  .project-card__metric-value {
    font-family: var(--font-mono);
    font-size: var(--text-2xl);
    font-weight: 600;
    line-height: 1;
    color: var(--fg);
  }

  .project-card__metric-label {
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }

  .project-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3);
    margin: 0;
    font-size: var(--text-sm);
  }

  /*
   * Brief §5c: a muted "·" separator between consecutive items. Drawn with
   * `::before` on siblings rather than as literal markup, so it appears exactly
   * once between each pair — including when `demo` is absent, where a
   * hand-placed separator would either dangle or need a conditional.
   */
  .project-card__meta > * + *::before {
    content: '·';
    margin-inline-end: var(--space-3);
    color: var(--fg-muted);
  }

  /* The primary language: the first entry of `stack`, a proper noun. */
  .project-card__lang {
    font-family: var(--font-mono);
    color: var(--fg-muted);
  }

  .project-card__date {
    font-family: var(--font-mono);
    color: var(--fg-subtle);
  }

  /* Brief §5c: links read in the accent, separators stay muted. */
  .project-card__meta a {
    color: var(--accent);
  }

  .project-card__note {
    margin: var(--space-2) 0 0;
    font-size: var(--text-sm);
    color: var(--fg-subtle);
  }
</style>
