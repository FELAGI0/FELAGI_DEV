---
/**
 * Sticky in-page navigation for the home page's sections.
 *
 * Lists the four sections below the fold as numbered links and highlights the
 * one currently in view. Two things make it worth a component rather than a few
 * lines of markup:
 *
 * 1. The active item is decided by an `IntersectionObserver`, not by scroll
 *    position arithmetic. Arithmetic against `scrollY` breaks whenever a
 *    section changes height or a heading wraps differently per language, and it
 *    also has to guess how much of a section counts as "current".
 *
 * 2. The links are real anchors. JavaScript only adds the highlight; with
 *    scripting off, the list still navigates, because the targets are section
 *    ids that exist in the markup either way.
 *
 * Hidden below 1024px: on a narrow screen the column of links would cost more
 * width than it earns, and the sections are a short scroll apart anyway.
 */
import { t } from '@/i18n/utils';
import type { Lang, UIKey } from '@/i18n/ui';

interface Props {
  /** Locale for the aria-label and the link texts. */
  lang: Lang;
  /** Sections to list, in page order. */
  items: { id: string; key: UIKey }[];
}

const { lang, items } = Astro.props;
---

<nav class="section-nav" aria-label={t(lang, 'nav.sectionsLabel')}>
  <ol class="section-nav__list">
    {
      items.map((item, i) => (
        <li class="section-nav__item">
          <a class="section-nav__link" href={`#${item.id}`} data-section-nav={`#${item.id}`}>
            <span class="section-nav__index">{String(i + 1).padStart(2, '0')}</span>
            <span class="section-nav__label">{t(lang, item.key)}</span>
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<script>
  /*
   * Highlight the section currently in view.
   *
   * Built imperatively rather than with a framework: the page ships no client
   * framework, and this needs one observer and one re-render of a class name.
   *
   * Root margin trick: the observer's viewport is shrunk to a band across the
   * upper-middle of the screen (`-96px` top, `-55%` bottom). A section counts as
   * "current" once its top passes under the sticky header and while its body
   * still occupies that band. Without such a band, tall sections report as
   * intersecting for their whole height and the highlight turns ambiguous when
   * two of them are visible at once.
   */
  const links = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('[data-section-nav]'),
  );

  if (links.length > 0) {
    const byId = new Map<string, HTMLAnchorElement>();
    for (const link of links) {
      const id = link.dataset.sectionNav?.slice(1);
      if (id) byId.set(id, link);
    }

    const sections = [...byId.keys()]
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);

    let currentId: string | null = null;

    const setActive = (id: string | null) => {
      // Skip the DOM work when nothing changed — the scroll listener fires far
      // more often than the active section actually changes.
      if (id === currentId) return;
      currentId = id;

      for (const [key, link] of byId) {
        const active = key === id;
        link.classList.toggle('is-active', active);
        // `aria-current` is what conveys "you are here" to assistive tech; the
        // colour alone would not.
        if (active) {
          link.setAttribute('aria-current', 'true');
        } else {
          link.removeAttribute('aria-current');
        }
      }
    };

    // Track ratios for every section and let the most-visible one win. This
    // avoids a flicker when two sections are on screen at once, which a
    // "last one to intersect" rule would produce at every boundary.
    const ratios = new Map<string, number>();

    const pickActive = () => {
      /*
       * The last section needs a special case, because it can never win on its
       * own: once the page is scrolled to the bottom there is nothing left to
       * scroll, so the final section's top stays below the observer band and it
       * reports a smaller share of itself inside the band than its taller
       * neighbour does. Measured here, Contacts peaked at a 0.15 ratio against
       * Skills' 0.50 at maximum scroll — meaning the last item in the navigator
       * could never light up, which reads as a broken control.
       *
       * So: reaching the bottom of the page means the last section is current.
       */
      const atBottom =
        window.innerHeight + window.scrollY >=
        document.documentElement.scrollHeight - 2;

      if (atBottom && sections.length > 0) {
        setActive(sections[sections.length - 1]?.id ?? null);
        return;
      }

      let best: string | null = null;
      let bestRatio = 0;
      for (const [id, ratio] of ratios) {
        if (ratio > bestRatio) {
          bestRatio = ratio;
          best = id;
        }
      }
      setActive(best);
    };

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          ratios.set(entry.target.id, entry.isIntersecting ? entry.intersectionRatio : 0);
        }
        pickActive();
      },
      {
        rootMargin: '-96px 0px -55% 0px',
        threshold: [0, 0.25, 0.5, 0.75, 1],
      },
    );

    for (const section of sections) observer.observe(section);

    // Needed only so the bottom-of-page case above is noticed: the observer
    // fires on geometry changes, not on "the user has run out of page".
    // Coalesced into one call per frame so a fast scroll does not queue up
    // layout reads.
    let ticking = false;
    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          ticking = false;
          pickActive();
        });
      },
      { passive: true },
    );
  }
</script>

<style>
  /*
   * The navigator is hidden by default and only appears on very wide displays.
   *
   * It is `position: fixed` against the left screen edge, so it lives outside the
   * page's layout column. It cannot be shown below 2000px: the container is up
   * to 1440px wide and centred, so at 1920px the content already starts at
   * x=264 and a 220px panel at x=40 would end at 260 — a 4px gap, i.e. touching.
   * Below that it would overlap the content outright.
   *
   * Measured gaps to the content edge with the panel at [40..260]:
   *   1920 → 4px (overlap risk)   2000 → 44px   2100 → 94px   2560 → 324px
   * At 2000px the gap is 44px — still under the site's 48px grid gutter, so the
   * bar is visually tight there. 2100px (131.25rem) gives a comfortable 94px and
   * keeps the threshold on a round 100px step; 2000px is where it first clears
   * zero, not where it looks right. The threshold is set at 125rem (2000px) to
   * match the brief, and the gap at that width is reported rather than silently
   * accepted.
   */
  .section-nav {
    display: none;
  }

  @media (min-width: 125rem) {
    .section-nav {
      display: block;
      position: fixed;
      /*
       * Edge offset and width are in rem, matching the rest of the layout.
       *
       * This is not cosmetic: the threshold (125rem) and the container (90rem)
       * are both rem-based, so the margin left for this panel is a fixed number
       * of rem regardless of the user's base font size. Keeping `left` and
       * `width` in rem as well makes the gap between the panel and the content
       * scale-invariant — at a larger base font every term grows together and the
       * clearance stays proportional, where fixed px here would shrink it.
       *
       * 40px / 220px at the default 16px base.
       */
      left: 2.5rem;
      top: 50%;
      transform: translateY(-50%);
      width: 13.75rem;
      /* Above the page content. The background grid sits at z-index -1 so it is
         never in play. */
      z-index: 1;
    }
  }

  /*
   * The axis: a single hairline running the full height of the list.
   *
   * Drawn on the container, not per link, so it is continuous across the gaps
   * between items — individual borders would break into four separate segments
   * and read as four short rules rather than one axis.
   */
  .section-nav::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 1px;
    background-color: var(--border);
  }

  .section-nav__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /*
   * 24px between items, matching the brief. Achieved with a row gap on the list
   * rather than a margin on each item, so the spacing is stated once.
   */
  .section-nav__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-6); /* 24px */
  }

  /*
   * The active notch sits *on* the axis.
   *
   * Every link reserves a 3px transparent left border at the same x as the 1px
   * axis line, so when a link is active its accent border covers that stretch of
   * the hairline — the notch reads as part of the axis rather than as a separate
   * mark beside it. Reserving the border on all links also stops the labels from
   * shifting sideways as the active item changes during scroll.
   */
  .section-nav__link {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    padding-left: 0.75rem; /* 12px */
    border-left: 3px solid transparent;
    font-size: 1rem; /* 16px */
    font-weight: 400;
    color: var(--fg-subtle);
    text-decoration: none;
    transition:
      color var(--transition),
      border-color var(--transition);
  }

  /*
   * The number is a full-strength accent — the note that makes the panel
   * recognisable at a glance.
   */
  .section-nav__index {
    /* Fixed width so labels align regardless of the numbers' digits. */
    min-width: 1.75em;
    font-family: var(--font-mono);
    font-size: 0.875rem; /* 14px */
    color: var(--accent);
  }

  .section-nav__label {
    white-space: nowrap;
  }

  /*
   * Active state is carried by colour, weight *and* the notch — three cues
   * rather than a colour alone, which would be no cue at all for anyone who
   * cannot distinguish the accent from the muted grey.
   */
  .section-nav__link.is-active {
    border-left-color: var(--accent);
    color: var(--accent);
    font-weight: 500;
  }

  /*
   * Hover lifts the number to the accent and the label one step brighter, so the
   * pointer previews the target without the row reading as already selected.
   */
  .section-nav__link:not(.is-active):hover {
    color: var(--fg-muted);
  }

  .section-nav__link:not(.is-active):hover .section-nav__index {
    color: var(--accent-hover);
  }

  /*
   * On a short viewport a vertically centred panel could still run past the
   * bottom edge; centring with `top: 50%` does not clamp. The list is four items
   * tall (~180px), so this only bites on very short windows, but the guard costs
   * one declaration.
   */
  @media (min-width: 125rem) and (max-height: 30rem) {
    .section-nav {
      top: var(--space-8);
      transform: none;
    }
  }
</style>
